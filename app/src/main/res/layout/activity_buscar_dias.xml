<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00897B">
<LinearLayout
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<TextView
    android:text="BÚSQUEDA POR DÍAS"
    android:textSize="22sp"
    android:textStyle="bold"
    android:textColor="#FFFFFF"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>

<TextView
    android:text="Atajos por rango:"
    android:textSize="14sp"
    android:textColor="#FFFFFF"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>

<LinearLayout
    android:id="@+id/lineaRangos1"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>

<LinearLayout
    android:id="@+id/lineaRangos2"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"/>

<TextView
    android:text="Seleccione días:"
    android:textSize="14sp"
    android:textColor="#FFFFFF"
    android:paddingTop="12dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>

<LinearLayout
    android:id="@+id/grillaDias"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>

<TextView
    android:id="@+id/diasSeleccionados"
    android:text="Días seleccionados: (ninguno)"
    android:textSize="14sp"
    android:textColor="#FFFFFF"
    android:textStyle="bold"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>

<Button
    android:id="@+id/btnBuscar"
    android:text="BUSCAR"
    android:textSize="16sp"
    android:textStyle="bold"
    android:backgroundTint="#8BC34A"
    android:textColor="#FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>

</LinearLayout>
</ScrollView>
