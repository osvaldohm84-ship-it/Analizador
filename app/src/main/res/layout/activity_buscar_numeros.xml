<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#00897B">
<LinearLayout
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

<TextView
    android:text="BÚSQUEDA POR NÚMEROS"
    android:textSize="22sp"
    android:textStyle="bold"
    android:textColor="#FFFFFF"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>

<TextView
    android:text="Números (00-99):"
    android:textSize="14sp"
    android:textColor="#FFFFFF"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>

<LinearLayout
    android:id="@+id/grillaNumeros"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>

<TextView
    android:text="Decenas (0-9):"
    android:textSize="14sp"
    android:textColor="#FFFFFF"
    android:paddingTop="12dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>

<LinearLayout
    android:id="@+id/grillaDecenas"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>

<TextView
    android:text="Terminales (0-9):"
    android:textSize="14sp"
    android:textColor="#FFFFFF"
    android:paddingTop="12dp"
    android:paddingBottom="6dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>

<LinearLayout
    android:id="@+id/grillaTerminales"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>

<TextView
    android:id="@+id/seleccionados"
    android:text="Seleccionados: (ninguno)"
    android:textSize="14sp"
    android:textColor="#FFFFFF"
    android:textStyle="bold"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>

<Button
    android:id="@+id/btnBuscar"
    android:text="BUSCAR"
    android:textSize="16sp"
    android:textStyle="bold"
    android:backgroundTint="#8BC34A"
    android:textColor="#FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"/>

</LinearLayout>
</ScrollView>
